---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import BeatGrid from "../components/BeatGrid.astro";
---
<BaseLayout title="Loja de beats" description="Catálogo de beats do Duck">
  <Nav active="/catalog" />
  <main class="shell catalog-page">
    <section class="catalog-hero"><div><span class="eyebrow">DUCK / CATÁLOGO PÚBLICO</span><h1>Instrumentais para desbloquear sua próxima <em>versão.</em></h1><p>Previews protegidos, licenças claras e entrega segura. Escolha o caminho da sua próxima faixa.</p></div><div class="catalog-note glass"><span>◈</span><b>PROTOCOLO DE ATIVO</b><small>Watermark antes da decisão.<br />URL assinada depois da confirmação.</small></div></section>
    <BeatGrid />
  </main>
</BaseLayout>
<style>
  .catalog-page { padding:64px 0 90px; } .catalog-hero { display:flex; align-items:end; justify-content:space-between; gap:30px; } .eyebrow { color:#55ddb0; font:500 10px 'DM Mono',monospace; letter-spacing:.2em; } h1 { max-width:730px; margin:14px 0 15px; font-size:clamp(38px,5.7vw,74px); line-height:1; letter-spacing:-.07em; } h1 em { color:#5ee4b1; font-style:normal; } .catalog-hero p { max-width:540px; margin:0; color:#7e9287; font-size:14px; line-height:1.75; } .catalog-note { display:grid; grid-template-columns:32px 1fr; column-gap:10px; min-width:220px; padding:17px; border-radius:16px; } .catalog-note span { grid-row:span 2; color:#5ee4b1; font-size:24px; } .catalog-note b,.catalog-note small { display:block; } .catalog-note b { color:#aeeed0; font:10px 'DM Mono',monospace; letter-spacing:.12em; } .catalog-note small { margin-top:8px; color:#71857a; font-size:11px; line-height:1.55; } @media(max-width:720px){ .catalog-page{padding-top:46px;} .catalog-hero{display:block;} .catalog-note{margin-top:26px;} }
</style>
