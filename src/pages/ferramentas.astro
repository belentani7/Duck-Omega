---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
---
<BaseLayout title="Ferramentas" description="Ferramentas operacionais do Duck Hub">
  <Nav active="/ferramentas" />
  <main class="shell tools-page">
    <section class="tools-heading"><div><span class="eyebrow">DUCK HUB / FERRAMENTAS</span><h1>Menos ruído.<br /><em>Mais comando.</em></h1><p>Recursos para transformar uma ideia em entrega rastreável.</p></div><a class="primary focus-ring" href="/hub">Voltar ao Hub →</a></section>
    <section class="tool-grid"><article class="glass tool"><span class="tool-icon">⌁</span><span class="eyebrow">01 / PROJETO</span><h2>Checklist de entrega</h2><p>Mix, master, stems, metadados, contrato e publicação em uma sequência clara.</p><button class="tool-action focus-ring">Ativar fluxo →</button></article><article class="glass tool"><span class="tool-icon">✦</span><span class="eyebrow">02 / OPERAÇÃO</span><h2>Automações do Duck</h2><p>Eventos para pagamentos, arquivos, revisões e acompanhamento de prazos.</p><button class="tool-action focus-ring">Configurar evento →</button></article><article class="glass tool"><span class="tool-icon">◈</span><span class="eyebrow">03 / RECURSOS</span><h2>Biblioteca protegida</h2><p>Stems, presets, referências e contratos organizados com URLs assinadas.</p><button class="tool-action focus-ring">Abrir biblioteca →</button></article><article class="glass tool"><span class="tool-icon">♫</span><span class="eyebrow">04 / ANÁLISE</span><h2>Saúde da sessão</h2><p>Veja prazo, revisões usadas, arquivos pendentes e o próximo movimento.</p><button class="tool-action focus-ring">Ver diagnóstico →</button></article></section>
    <section class="glass automation"><div><span class="eyebrow">STATUS DO SISTEMA</span><h2>Os fluxos estão preparados.</h2><p>A ativação de serviços externos permanece protegida por aprovação e configuração explícita.</p></div><div class="automation-status"><span class="pulse"></span><b>BACKEND ONLINE</b><small>tRPC · Storage · Auth</small></div></section>
  </main>
</BaseLayout>
<style>
  .tools-page { padding:64px 0 110px; } .tools-heading { display:flex; align-items:end; justify-content:space-between; gap:25px; } .eyebrow { color:#55ddb0; font:500 10px 'DM Mono',monospace; letter-spacing:.2em; } h1 { margin:14px 0; font-size:clamp(44px,6vw,76px); line-height:.98; letter-spacing:-.07em; } h1 em { color:#5ee4b1; font-style:normal; } .tools-heading p { margin:0; color:#7e9287; font-size:14px; } .primary { display:inline-flex; padding:13px 17px; border-radius:11px; color:#04100a; background:#5ee4b1; text-decoration:none; font-size:12px; font-weight:700; white-space:nowrap; } .tool-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; margin-top:48px; } .tool { padding:23px; border-radius:20px; } .tool-icon { display:grid; place-items:center; width:45px; height:45px; margin-bottom:28px; border-radius:14px; color:#5ee4b1; background:rgba(52,211,153,.1); font-size:22px; } .tool h2 { margin:12px 0 8px; font-size:22px; letter-spacing:-.04em; } .tool p { min-height:45px; margin:0; color:#758980; font-size:13px; line-height:1.7; } .tool-action { margin-top:25px; border:0; padding:0; color:#68e5b7; background:none; cursor:pointer; font-size:12px; font-weight:700; } .automation { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-top:14px; padding:24px; border-radius:20px; } .automation h2 { margin:10px 0 7px; font-size:22px; } .automation p { margin:0; color:#758980; font-size:12px; } .automation-status { min-width:150px; padding:15px; border:1px solid rgba(52,211,153,.18); border-radius:13px; } .pulse { display:inline-block; width:8px; height:8px; margin-right:7px; border-radius:50%; background:#5ee4b1; box-shadow:0 0 13px #5ee4b1; } .automation-status b,.automation-status small { display:block; } .automation-status b { color:#9fecc9; font:10px 'DM Mono',monospace; } .automation-status small { margin-top:8px; color:#71857a; font-size:10px; } @media(max-width:720px){ .tools-page{padding-top:46px;} .tools-heading{display:block;} .tools-heading .primary{margin-top:25px;} .tool-grid{grid-template-columns:1fr; margin-top:35px;} .tool p{min-height:auto;} .automation{display:block;} .automation-status{margin-top:22px;} }
</style>
