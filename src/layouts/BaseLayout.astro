---
const { title = "Duck Hub", description = "Núcleo operacional do produtor Duck" } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050907" />
    <meta name="description" content={description} />
    <title>{title} · Duck Hub</title>
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
  @import "tailwindcss";
  :root { color-scheme: dark; font-family: 'Manrope', system-ui, sans-serif; background: #050907; color: #e4f3eb; }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; background: #050907; }
  button, a, input { font: inherit; }
  button, a { -webkit-tap-highlight-color: transparent; }
  .mono { font-family: 'DM Mono', monospace; }
  .shell { width: min(1180px, calc(100% - 32px)); margin-inline: auto; }
  .glass { border: 1px solid rgba(167, 243, 208, .10); background: linear-gradient(145deg, rgba(12, 28, 21, .92), rgba(7, 16, 12, .78)); box-shadow: 0 22px 70px rgba(0,0,0,.25); backdrop-filter: blur(18px); }
  .focus-ring:focus-visible { outline: 2px solid #34d399; outline-offset: 3px; }
  .noise { position: fixed; inset: 0; pointer-events: none; opacity: .035; z-index: 20; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.45'/%3E%3C/svg%3E"); }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
</style>
